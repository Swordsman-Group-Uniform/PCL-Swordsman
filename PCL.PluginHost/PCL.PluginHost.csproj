<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>PCL.PluginHost</AssemblyName>
        <RootNamespace>PCL.PluginHost</RootNamespace>
        <AssemblyTitle>PCL Plugin Host</AssemblyTitle>
        <Description>PCLCE For SGU 插件宿主：发现、校验、加载、生命周期与配置持久化</Description>
        <Company>剑客群组服服主团队</Company>
        <Product>PCLCE For SGU</Product>
        <Copyright>Copyright © 剑客群组服服主团队（下游）；上游代码版权归 PCL Community 与龙腾猫跃</Copyright>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Configurations>Debug;CI;Release;Beta</Configurations>
        <Platforms>AnyCPU;x64;ARM64</Platforms>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\PCL.PluginSdk\PCL.PluginSdk.csproj" />
    </ItemGroup>
</Project>
