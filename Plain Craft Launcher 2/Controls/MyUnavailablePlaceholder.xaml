<Grid x:Class="PCL.MyUnavailablePlaceholder"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="PanBack" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- 居中的「不可用」占位：完整复用 PCL 加载控件 MyLoading 的错误态图形与动画
         （红色镐子 + 红叉 + 叉下方的横杠，与 Minecraft 下载报错页一模一样） -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
        <Grid Width="132" Height="104" HorizontalAlignment="Center">
            <Viewbox Stretch="Uniform" Width="132" Height="104">
                <Grid Width="60" Height="47">
                    <!-- 镐子：与 MyLoading 完全一致的几何与旋转 -->
                    <Path x:Name="PathPickaxe" Stretch="Uniform" Height="35" Margin="10,6,0,0" StrokeThickness="2"
                          Data="M 963.6 858.2 410.816 305.504 C 508.116 213.304 609.204 196.8 711.104 128.6 837.11367 49.573762 879.34045 50.334062 751.5 49.5 611.3 52 471.8 96.2 353.3 182.4 309.8 155.7 252.1 161.2 214.5 198.9 176.9 236.6 171.3 294.2 198 337.7 111.8 456.3 67.6 595.8 65.1 735.9 63.315254 883.82034 65.077966 837.29308 144.2 695.488 212.4 593.588 228.888 492.4 321.088 395.2 L 873.9 948 c 0.60001 0.59999 1.6 0.6 2.2 0 l 87.5 -87.5 c 0.6 -0.7 0.6 -1.6 0 -2.3 z"
                          Stroke="{Binding Foreground, ElementName=PanBack}"
                          HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Path.RenderTransform>
                            <RotateTransform Angle="55" CenterX="30" CenterY="30" />
                        </Path.RenderTransform>
                    </Path>
                    <!-- 叉：与 MyLoading 错误态完全一致的几何、位置与初始缩放 -->
                    <Path x:Name="PathCross" Opacity="0" Stretch="Uniform"
                          Fill="{Binding Foreground, ElementName=PanBack}"
                          Width="17" Height="17" Data="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z"
                          Margin="4,23,0,0" RenderTransformOrigin="0.5,0.5"
                          HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Path.RenderTransform>
                            <ScaleTransform ScaleX="0.6" ScaleY="0.6" />
                        </Path.RenderTransform>
                    </Path>
                    <!-- 红叉底下那条横杠：MyLoading 里一直都有，之前漏掉了 -->
                    <Rectangle Width="25" Height="2" Fill="{Binding Foreground, ElementName=PanBack}"
                               VerticalAlignment="Bottom" HorizontalAlignment="Left" />
                </Grid>
            </Viewbox>
        </Grid>
        <TextBlock x:Name="LabText" Margin="0,24,0,0" HorizontalAlignment="Center"
                   FontSize="15" LineHeight="24" TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{Binding Foreground, ElementName=PanBack}" />
    </StackPanel>
</Grid>
