<local:MyPageRight x:Class="PCL.PageSetupPlugins"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10,25,10" Grid.IsSharedSizeScope="True">
            <!-- 说明 -->
            <local:MyCard Margin="0,15,0,15">
                <StackPanel Margin="20,16,18,18">
                    <TextBlock Text="{DynamicResource Setup.Plugins.Title}" FontSize="15" FontWeight="Bold" />
                    <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray3}"
                               Text="{DynamicResource Setup.Plugins.Description}" />
                </StackPanel>
            </local:MyCard>

            <!-- 每个提供设置的插件一张卡片（卡片内容由代码生成） -->
            <StackPanel x:Name="PanPluginCards" />

            <!-- 空状态 -->
            <local:MyCard x:Name="PanEmpty" Margin="0,0,0,15" Visibility="Collapsed">
                <StackPanel Margin="20,17">
                    <TextBlock Text="{DynamicResource Setup.Plugins.Empty}" FontSize="13" FontWeight="Bold"
                               TextWrapping="Wrap" HorizontalAlignment="Center" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
