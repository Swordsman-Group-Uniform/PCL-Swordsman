<local:MyPageRight x:Class="PCL.PageToolsPluginMarket"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyHint x:Name="HintMarketState" Margin="10,15,10,5" Theme="Yellow"
                          Text="{DynamicResource Tools.Plugin.Market.StateHint}" />
            <local:MyCard Margin="0,15" Title="{DynamicResource Tools.Plugin.Market.Intro.Title}">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock Text="{DynamicResource Tools.Plugin.Market.Intro.Description}" TextWrapping="Wrap"
                               LineHeight="22" />
                    <TextBlock Text="{DynamicResource Tools.Plugin.Market.Intro.Plan}" TextWrapping="Wrap"
                               Margin="0,12,0,0" Opacity="0.8" LineHeight="22" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Tools.Plugin.Market.Format.Title}" CanSwap="True">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock Text="{DynamicResource Tools.Plugin.Market.Format.Description}" TextWrapping="Wrap"
                               Opacity="0.8" LineHeight="22" FontFamily="Consolas, Microsoft YaHei UI" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
