<local:MyPageRight x:Class="PCL.PageDownloadBlocked"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <!-- 下载功能被关闭时统一显示的占位页。
         结构与「设置 → 反馈」被禁用时的显示完全一致：MyCard 内嵌 MyUnavailablePlaceholder。 -->
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,25,25,25">
            <local:MyCard UseAnimation="False" MinHeight="300" Margin="10,0,10,0">
                <local:MyUnavailablePlaceholder x:Name="BlockedHint"
                                                Text="{DynamicResource Download.Disabled.Message}" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
